<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<AnchorPane prefHeight="908.0" prefWidth="1190.0"
            stylesheets="@../../../style/app.css"
            xmlns="http://javafx.com/javafx/25"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.seu.pfmfx.controller.CategoryController">

    <children>

        <Label layoutX="30.0" layoutY="20.0"
               text="Category Management"
               styleClass="page-title"/>

        <VBox layoutX="30.0" layoutY="80.0"
              prefWidth="1130.0"
              spacing="15.0"
              styleClass="card">

            <Label text="Add New Category" styleClass="section-title"/>

            <HBox spacing="15.0">

                <TextField fx:id="txtCategoryName"
                           prefWidth="250.0"
                           promptText="Category Name"/>

                <ComboBox fx:id="cbType"
                          prefWidth="200.0"
                          promptText="Type (Income / Expense)"/>

                <Button fx:id="btnAddCategory"
                        prefWidth="150.0"
                        text="Add Category"
                        styleClass="primary-btn"/>

            </HBox>

        </VBox>

        <VBox layoutX="30.0" layoutY="250.0"
              prefWidth="1130.0"
              prefHeight="635.0"
              styleClass="card">

            <Label text="Category List" styleClass="section-title"/>

            <TableView fx:id="categoryTable"
                       prefWidth="1090.0"
                       prefHeight="570.0">

                <columns>
                    <TableColumn fx:id="colName"
                                 text="Category Name"
                                 prefWidth="400.0"/>

                    <TableColumn fx:id="colType"
                                 text="Type"
                                 prefWidth="300.0"/>

                    <TableColumn fx:id="colStatus"
                                 text="Status"
                                 prefWidth="390.0"/>
                </columns>

            </TableView>

        </VBox>

    </children>
</AnchorPane>
