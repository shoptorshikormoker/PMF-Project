<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<AnchorPane prefHeight="908.0" prefWidth="1190.0" stylesheets="@../../../style/app.css" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.seu.pfmfx.controller.CategoryController">

    <children>

        <Label layoutX="30.0" layoutY="20.0" styleClass="page-title" text="Category Management" />

        <VBox layoutX="30.0" layoutY="80.0" prefWidth="1130.0" spacing="15.0" styleClass="card">

            <Label styleClass="section-title" text="Add New Category" />

            <HBox spacing="15.0">

                <TextField fx:id="categoryNameField" prefWidth="250.0" promptText="Category Name" />

                <ComboBox fx:id="typeField" prefWidth="200.0" promptText="Type (Income / Expense)" />

                <Button fx:id="btnActionCategory" prefHeight="29.0" prefWidth="150.0" styleClass="primary-btn" text="Add Category" />
            <Button fx:id="btnDeleteCategory" disable="true" prefHeight="29.0" prefWidth="89.0" styleClass="danger-btn" text="Delete" />
            <Button fx:id="btnReset" prefHeight="29.0" prefWidth="89.0" styleClass="reset-btn" text="Reset" textFill="#b6c357" />

            </HBox>

        </VBox>

        <VBox layoutX="30.0" layoutY="250.0" prefHeight="635.0" prefWidth="1130.0" styleClass="card">

            <Label styleClass="section-title" text="Category List" />

            <TableView fx:id="categoryTable" prefHeight="570.0" prefWidth="1090.0">

                <columns>
               <TableColumn fx:id="colId" prefWidth="159.0" text="Id" />
                    <TableColumn fx:id="colName" prefWidth="559.0" text="Category Name" />

                    <TableColumn fx:id="colType" prefWidth="371.0" text="Type" />
                </columns>

            </TableView>

        </VBox>

    </children>
</AnchorPane>
