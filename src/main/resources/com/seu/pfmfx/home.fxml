<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="900.0" prefWidth="1440.0" style="-fx-background-color: FFFFFF;" stylesheets="@../../../style/app.css" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.seu.pfmfx.controller.HomeController">
   <children>
      <VBox layoutX="15.0" layoutY="90.0" prefHeight="658.0" prefWidth="209.0" spacing="7.0" style="-fx-background-color: ffffff;">
         <children>
            <Button fx:id="navDashboardBtn" alignment="TOP_LEFT" maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#btnDashboardOnAction" prefHeight="45.0" prefWidth="224.0" style="-fx-padding: 10 10 10 20;" styleClass="nav-btn" text="Dashboard" textFill="WHITE">
               <font>
                  <Font size="16.0" />
               </font>
            </Button>
            <Button fx:id="navIncomeBtn" alignment="TOP_LEFT" maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#btnIncomeOnAction" style="-fx-padding: 10 10 10 20;" styleClass="nav-btn" text="Income">
               <font>
                  <Font size="16.0" />
               </font>
            </Button>
            <Button fx:id="navExpenseBtn" alignment="TOP_LEFT" layoutX="10.0" layoutY="172.0" maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#btnExpenseOnAction" style="-fx-padding: 10 10 10 20;" styleClass="nav-btn" text="Expense">
               <font>
                  <Font size="16.0" />
               </font>
            </Button>
            <Button fx:id="navBudgetBtn" alignment="TOP_LEFT" layoutX="10.0" layoutY="217.0" maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#btnBudgetOnAction" style="-fx-padding: 10 10 10 20;" styleClass="nav-btn" text="Budget">
               <font>
                  <Font size="16.0" />
               </font>
            </Button>
            <Button fx:id="navTrxBtn" alignment="TOP_LEFT" layoutX="10.0" layoutY="262.0" maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#btnTransactionOnAction" style="-fx-padding: 10 10 10 20;" styleClass="nav-btn" text="Transaction History">
               <font>
                  <Font size="16.0" />
               </font>
            </Button>
            <Button fx:id="navcatBtn" alignment="TOP_LEFT" maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#btnCategoryOnAction" style="-fx-padding: 10 10 10 20;" styleClass="nav-btn" text="Category">
               <font>
                  <Font size="16.0" />
               </font>
            </Button>
         </children>
      </VBox>
      <VBox layoutX="14.0" layoutY="769.0" prefHeight="100.0" prefWidth="209.0" spacing="10.0" style="-fx-background-color: F1F5FB;" styleClass="card">
         <children>
            <HBox prefHeight="100.0" prefWidth="200.0" spacing="10.0">
               <children>
                  <Label text="Name" />
                  <Label fx:id="lblUserFullName" />
               </children>
            </HBox>
            <HBox prefHeight="100.0" prefWidth="200.0" spacing="10.0">
               <children>
                  <Label text="Email" />
                  <Label fx:id="lblUserEmail" />
               </children>
            </HBox>
            <Button fx:id="navLogoutBtn" mnemonicParsing="false" onAction="#navLogoutBtnOnAction" prefHeight="30.0" prefWidth="210.0" styleClass="danger-btn" text="Logout" />
         </children>
      </VBox>
      <AnchorPane fx:id="contentPane" layoutX="244.0" prefHeight="903.0" prefWidth="1190" style="-fx-background-color: #E8E8E8;" />
      <Label alignment="CENTER" layoutX="1.0" layoutY="-1.0" prefHeight="91.0" prefWidth="250.0" text="PFM SYSTEM" textAlignment="CENTER" textFill="#151d48">
         <font>
            <Font name="System Bold" size="31.0" />
         </font>
      </Label>
